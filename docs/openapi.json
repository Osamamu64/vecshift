  "components": {
    "schemas": {
      "ApplyOptions": {
        "properties": {
          "no_index": {
            "type": "boolean",
            "title": "No Index",
            "description": "Backfill only; build the index on a later run.",
            "default": false
          },
          "until": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 99.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Until",
            "description": "Stop once this percentage has a new vector."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ApplyOptions"
      },
      "ApplyRun": {
        "properties": {
          "confirm": {
            "$ref": "#/components/schemas/Confirm"
          },
          "allow_remote": {
            "type": "boolean",
            "title": "Allow Remote",
            "description": "Allow sending text to a model that isn't on this machine.",
            "default": false
          },
          "action": {
            "type": "string",
            "const": "apply",
            "title": "Action"
          },
          "options": {
            "$ref": "#/components/schemas/ApplyOptions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action"
        ],
        "title": "ApplyRun"
      },
      "CleanupRun": {
        "properties": {
          "confirm": {
            "$ref": "#/components/schemas/Confirm"
          },
          "allow_remote": {
            "type": "boolean",
            "title": "Allow Remote",
            "description": "Allow sending text to a model that isn't on this machine.",
            "default": false
          },
          "action": {
            "type": "string",
            "const": "cleanup",
            "title": "Action"
          },
          "options": {
            "$ref": "#/components/schemas/Empty"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action"
        ],
        "title": "CleanupRun"
      },
      "Confirm": {
        "properties": {
          "apply": {
            "type": "boolean",
            "title": "Apply",
            "description": "apply: it changes the database and spends money.",
            "default": false
          },
          "switch": {
            "type": "boolean",
            "title": "Switch",
            "description": "cutover and rollback: they switch searches.",
            "default": false
          },
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ],
            "title": "Name",
            "description": "cleanup: the name of the old column or collection it deletes."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Confirm"
      },
      "CutoverOptions": {
        "properties": {
          "check_only": {
            "type": "boolean",
            "title": "Check Only",
            "description": "Only check that cutover is safe.",
            "default": false
          },
          "allow_missing": {
            "type": "boolean",
            "title": "Allow Missing",
            "description": "Switch even though the provider rejected some rows.",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CutoverOptions"
      },
      "CutoverRun": {
        "properties": {
          "confirm": {
            "$ref": "#/components/schemas/Confirm"
          },
          "allow_remote": {
            "type": "boolean",
            "title": "Allow Remote",
            "description": "Allow sending text to a model that isn't on this machine.",
            "default": false
          },
          "action": {
            "type": "string",
            "const": "cutover",
            "title": "Action"
          },
          "options": {
            "$ref": "#/components/schemas/CutoverOptions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action"
        ],
        "title": "CutoverRun"
      },
      "DoctorRequest": {
        "properties": {
          "store": {
            "type": "string",
            "enum": [
              "pgvector",
              "qdrant"
            ],
            "title": "Store"
          },
          "dsn_env": {
