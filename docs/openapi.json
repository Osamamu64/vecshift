    "/api/v1/jobs/{name}/runs": {
      "post": {
        "summary": "Start Run",
        "description": "Start apply, eval, cutover, rollback, or cleanup in the background.\n\nThe confirmation each needs (`confirm.apply`, `confirm.switch`, or `confirm.name`)\nand `allow_remote` are checked first: a missing one is a 422, and nothing starts.",
        "operationId": "start_run_api_v1_jobs__name__runs_post",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/ApplyRun"
                  },
                  {
                    "$ref": "#/components/schemas/EvalRun"
                  },
                  {
                    "$ref": "#/components/schemas/CutoverRun"
                  },
                  {
                    "$ref": "#/components/schemas/RollbackRun"
                  },
                  {
                    "$ref": "#/components/schemas/CleanupRun"
                  }
                ],
                "title": "Request"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunStarted"
                }
              }
            }
          },
          "404": {
            "description": "A problem (RFC 9457).",
