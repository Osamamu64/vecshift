    "/api/v1/jobs/{name}/plan": {
      "get": {
        "summary": "Plan",
        "description": "The same JSON as `vecshift plan --json`. Read-only. A probe that would send sample\nrows to a remote model needs `allow_remote=true`.",
        "operationId": "plan_api_v1_jobs__name__plan_get",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          },
          {
            "name": "probe",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Probe"
            }
          },
          {
            "name": "sample",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100000,
              "minimum": 50,
              "default": 2000,
              "title": "Sample"
            }
          },
          {
            "name": "allow_remote",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Allow Remote"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Plan Api V1 Jobs  Name  Plan Get"
                }
              }
            }
          },
